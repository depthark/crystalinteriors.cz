# Public (build time) ---------------------------------------------------------
PUBLIC_SITE_URL=https://www.crystalinteriors.cz

# Cloudflare Pages secrets (runtime, functions/) – set in the dashboard -------
# GITHUB_CLIENT_ID=…            GitHub OAuth app for the CMS login
# GITHUB_CLIENT_SECRET=…        (encrypted)
# DEPLOY_HOOK_URL=…             optional Pages deploy hook
# RESEND_API_KEY=…              contact form e-mails (functions/api/inquiry.ts)
# INQUIRY_FROM=…                optional, default "Crystal Interiors <web@crystalinteriors.cz>"
# INQUIRY_TO=…                  optional comma-separated recipients (default: CMS contacts)
