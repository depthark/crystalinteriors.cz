---
/**
 * One project on /projekty/: title, location/year, description and gallery.
 *
 * Media come from `getProjectMedia()`: the build-time Cloudinary scan merged
 * with the CMS (anewstyle approach), or the CMS list alone. They render at
 * build time – crawlable, AVIF/WebP via Cloudinary, sized with srcset.
 * Videos open as HTML5 video in Fancybox. Projects without any media fall back
 * to their optional Cloudinary tag at runtime (src/pages/projekty.astro).
 */
import type { Project } from "@/data/site";
import { getProjectMedia } from "@/lib/cloudinary-gallery";

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const galleryId = `project-${project.slug}`;
const headingId = `${galleryId}-title`;
const descriptionId = `${galleryId}-description`;
const media = getProjectMedia(project);
const meta = [project.location, project.year].filter(Boolean);
const paragraphs = project.text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const isStatic = media.length > 0;
const sizes = "(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 92vw";
---

<section
  id={project.slug}
  class="scroll-mt-28 grid gap-8 border-t border-border py-12 first:border-t-0 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14"
  data-references-section
  data-static={isStatic ? "true" : undefined}
  data-tag={project.tag}
  data-gallery-id={galleryId}
  data-title={project.title}
  aria-labelledby={headingId}
  aria-describedby={descriptionId}
>
  <div class="space-y-4 lg:sticky lg:top-28 lg:self-start">
    {
      meta.length > 0 && (
        <p class="text-sm font-medium uppercase tracking-eyebrow text-primary">{meta.join(" · ")}</p>
      )
    }
    <h2 id={headingId} class="text-3xl leading-tight text-foreground">{project.title}</h2>
    <div id={descriptionId} class="space-y-4 text-base leading-8 text-muted">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>

  <div class="py-4" aria-busy={isStatic ? "false" : "true"} aria-live="polite" data-references-live>
    {
      !isStatic && (
        <p class="text-sm leading-7 text-muted" data-references-status>
          Načítání referencí…
        </p>
      )
    }
    <ul
      class:list={["references-grid list-none", !isStatic && "hidden"]}
      data-references-grid
      aria-label={`Galerie — ${project.title}`}
    >
      {
        media.map((item) => (
          <li>
            <a
              href={item.full}
              data-fancybox={galleryId}
              data-caption={item.alt}
              data-type={item.type === "video" ? "html5video" : undefined}
              data-width={item.fullWidth}
              data-height={item.fullHeight}
              aria-label={`${item.type === "video" ? "Přehrát video" : "Zvětšit"}: ${item.alt}`}
              class="glass-hover group relative block overflow-hidden rounded-lg bg-surface shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-lifted"
            >
              <img
                src={item.thumb}
                srcset={item.thumbSrcset}
                sizes={item.thumbSrcset ? sizes : undefined}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              {
                item.type === "video" && (
                  <span
                    class="pointer-events-none absolute inset-0 z-[3] grid place-items-center"
                    aria-hidden="true"
                  >
                    <span class="grid h-14 w-14 place-items-center rounded-full bg-black/55 text-white shadow-lifted backdrop-blur-sm transition-transform duration-300 group-hover:scale-110">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
                    </span>
                  </span>
                )
              }
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .references-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: calc(var(--spacing) * 4);
  }

  .references-grid.hidden {
    display: none;
  }

  /* First tile leads: double size on wider screens. */
  @media (min-width: 640px) {
    .references-grid > :global(li:first-child:not(:only-child)) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .references-grid > :global(li:first-child:not(:only-child) img) {
      height: 100%;
    }
  }
</style>
