---
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";
import SocialLinks from "./SocialLinks.astro";
import Icon from "./ui/Icon.astro";

export interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const activePath =
  pathname === "/" ? "/" : pathname.endsWith("/") ? pathname : `${pathname}/`;
---

<!--
  Mobile navigation on the native Popover API – no JavaScript for open/close:
  the button toggles the panel (popovertarget), Escape and a tap outside close
  it and return focus, the browser exposes aria-expanded. The panel sits in
  the top layer just below the sticky header, so logo, theme toggle and the
  button (hamburger → X via :has()) stay visible and usable. Baseline 2024.
-->
<div class="lg:hidden">
  <button
    type="button"
    popovertarget="mobile-menu-panel"
    class="mobile-menu__toggle inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-border bg-background/60 text-foreground backdrop-blur transition-colors duration-fast ease-standard hover:border-primary hover:text-primary focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    aria-label="Navigace"
  >
    <span class="relative block h-4 w-5" aria-hidden="true">
      <span class="mobile-menu__bar absolute inset-x-0 top-0 h-0.5 origin-center rounded-full bg-current"></span>
      <span class="mobile-menu__bar absolute inset-x-0 top-1/2 h-0.5 origin-center -translate-y-1/2 rounded-full bg-current"></span>
      <span class="mobile-menu__bar absolute inset-x-0 bottom-0 h-0.5 origin-center rounded-full bg-current"></span>
    </span>
  </button>

  <div id="mobile-menu-panel" popover class="mobile-menu glass-strong">
    <div class="flex h-full flex-col gap-6 overflow-y-auto px-4 pt-6 pb-8 sm:px-6 min-[480px]:gap-8 min-[480px]:pb-10">
      <nav class="flex w-full flex-1 items-center" aria-label="Hlavní navigace">
        <ul class="m-0 flex w-full list-none flex-col gap-2 p-0">
          {
            site.nav.map((item, index) => {
              const isActive = activePath === item.href;
              return (
                <li class="mobile-menu__item" style={`--i:${index};`}>
                  <a
                    href={withBase(item.href)}
                    class:list={[
                      "mobile-menu__link flex cursor-pointer items-center border-b border-border py-3 font-display leading-[1.1] no-underline transition-colors duration-fast ease-standard",
                      isActive ? "text-royal" : "text-foreground hover:text-primary focus-visible:text-primary",
                    ]}
                    aria-current={isActive ? "page" : undefined}
                    autofocus={index === 0}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4">
        <a
          href={withBase("/kontakt/#poptavka")}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-action px-6 py-3.5 font-display text-base font-semibold text-on-action no-underline shadow-lifted transition-colors duration-fast ease-standard hover:bg-action-hover focus-visible:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Kontaktujte nás
          <Icon name="arrow-right" variant="mini" class="h-5 w-5" />
        </a>

        <div class="flex justify-center border-t border-border pt-4">
          <SocialLinks variant="card" align="center" />
        </div>
      </div>
    </div>
  </div>
</div>

<!-- The only script: a tapped link closes the panel (same-page anchors, and
     no open menu when the page comes back from the back/forward cache). -->
<script is:inline>
  document.getElementById("mobile-menu-panel")?.addEventListener("click", (e) => {
    if (e.target.closest("a")) e.currentTarget.hidePopover();
  });
</script>

<style>
  /* Panel: full width below the sticky header (top layer, so it never fights
     z-index), sliding in with @starting-style; UA popover styles reset. */
  .mobile-menu {
    position: fixed;
    inset: var(--header-height) 0 0;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    border-top: 1px solid var(--color-border);
    color: inherit;
    opacity: 0;
    translate: 0 -1rem;
    transition:
      opacity var(--duration-standard) var(--ease-out-soft),
      translate var(--duration-slow) var(--ease-out-soft),
      overlay var(--duration-standard) allow-discrete,
      display var(--duration-standard) allow-discrete;
  }

  .mobile-menu:popover-open {
    opacity: 1;
    translate: 0;
  }

  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      translate: 0 -1rem;
    }
  }

  /* Links rise in one after another (stagger needs calc() with --i). */
  .mobile-menu__item {
    opacity: 0;
    translate: 0 0.75rem;
    transition:
      opacity var(--duration-standard) var(--ease-out-soft),
      translate var(--duration-standard) var(--ease-out-soft);
    transition-delay: calc(var(--i, 0) * 60ms + 120ms);
  }

  .mobile-menu:popover-open .mobile-menu__item {
    opacity: 1;
    translate: 0;
  }

  @starting-style {
    .mobile-menu:popover-open .mobile-menu__item {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  /* Fluid type for nav links – clamp() with vw. */
  .mobile-menu__link {
    font-size: clamp(1.375rem, 5.5vw, 2.25rem);
  }

  /* Hamburger → X while the panel is open (no state attribute, no JS). */
  .mobile-menu__bar {
    transition:
      transform var(--duration-standard) var(--ease-out-soft),
      opacity var(--duration-fast) var(--ease-standard),
      top var(--duration-standard) var(--ease-out-soft),
      bottom var(--duration-standard) var(--ease-out-soft);
  }

  :global(html:has(#mobile-menu-panel:popover-open)) .mobile-menu__bar:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  :global(html:has(#mobile-menu-panel:popover-open)) .mobile-menu__bar:nth-child(2) {
    opacity: 0;
    transform: translateY(-50%) scaleX(0);
  }

  :global(html:has(#mobile-menu-panel:popover-open)) .mobile-menu__bar:nth-child(3) {
    bottom: 50%;
    transform: translateY(50%) rotate(-45deg);
  }

  /* No page scrolling behind the open panel; on desktop the panel is gone. */
  @media (max-width: 63.999rem) {
    :global(html:has(#mobile-menu-panel:popover-open)) {
      overflow: hidden;
    }
  }

  @media (min-width: 64rem) {
    .mobile-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu__item {
      transition: none;
    }
  }
</style>
