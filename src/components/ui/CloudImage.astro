---
/**
 * Responsive image served through Cloudinary (AVIF/WebP via f_auto).
 *
 * Always reserves its box with width/height (no CLS). Pass `priority` for the
 * LCP image: eager + fetchpriority=high; everything else lazy-loads.
 */
import type { HTMLAttributes } from "astro/types";
import { cloudinaryImage, cloudinarySrcset } from "@/lib/cloudinary";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "srcset" | "width" | "height"> {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Candidate widths for srcset. */
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  fit?: "fill" | "limit";
}

const {
  src,
  alt,
  width,
  height,
  widths = [480, 768, 1024, 1440],
  sizes = "100vw",
  priority = false,
  fit = "fill",
  ...attrs
} = Astro.props;

const ratio = fit === "fill" ? width / height : undefined;
const srcset = cloudinarySrcset(src, widths, { ratio, fit });
const fallback = cloudinaryImage(src, { width, height: ratio ? height : undefined, fit });
---

<img
  src={fallback}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={priority ? "eager" : "lazy"}
  decoding={priority ? "sync" : "async"}
  fetchpriority={priority ? "high" : undefined}
  {...attrs}
/>
