---
/**
 * Hero: full-bleed photo (LCP, preloaded) under an ink overlay, the official
 * Crystal Interiors logo as the brand moment, serif headline and two CTAs.
 * Content enters with a short staggered rise (motion-safe only) and a scroll
 * cue leads into the first section.
 */
import { site } from "@/data/site";
import { hero } from "@/lib/images";
import { withBase } from "@/lib/navigation";
import Button from "./ui/Button.astro";
import ResponsiveImage from "./ui/ResponsiveImage.astro";
import ChevronDownIcon from "./icons/ChevronDownIcon.astro";
---

<section class="relative isolate overflow-hidden bg-ink-deep" aria-labelledby="hero-title">
  <div class="absolute inset-0" aria-hidden="true">
    <ResponsiveImage
      src={site.hero.image}
      alt=""
      width={hero.width}
      height={hero.height}
      sizes={hero.sizes}
      priority
      class="h-full w-full scale-105 object-cover motion-safe:animate-hero-zoom"
    />
    <div class="hero__overlay absolute inset-0"></div>
  </div>

  <div class="relative mx-auto flex min-h-[88svh] max-w-4xl flex-col items-center justify-center px-4 pb-24 pt-16 text-center sm:min-h-[92svh] sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-6 text-white sm:gap-7">
      <img
        src={withBase("/images/logos/crystalinteriors_logo-white.svg")}
        alt={`${site.name} – vizualizace, design, realizace`}
        width="248"
        height="248"
        loading="eager"
        decoding="async"
        class="hero__rise h-auto w-36 drop-shadow-[0_6px_24px_rgb(0_0_0/0.35)] sm:w-44 md:w-52"
        style="--i: 0"
      />

      <p
        class="hero__rise inline-flex items-center gap-3 whitespace-nowrap text-[0.7rem] font-medium uppercase tracking-eyebrow text-white/80 sm:text-xs sm:tracking-overline"
        style="--i: 1"
      >
        <span class="hidden h-px w-10 bg-accent/80 sm:block" aria-hidden="true"></span>
        {site.hero.eyebrow}
        <span class="hidden h-px w-10 bg-accent/80 sm:block" aria-hidden="true"></span>
      </p>

      <h1
        id="hero-title"
        class="hero__rise mx-auto max-w-3xl text-balance text-3xl leading-[1.12] sm:text-4xl md:text-5xl lg:text-6xl"
        style="--i: 2"
      >
        {site.hero.title}
      </h1>

      {
        site.hero.text && (
          <p
            class="hero__rise mx-auto max-w-2xl text-balance text-base leading-7 text-white/85 sm:text-lg sm:leading-8"
            style="--i: 3"
          >
            {site.hero.text}
          </p>
        )
      }

      <div
        class="hero__rise flex w-full flex-col items-stretch justify-center gap-3 pt-2 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center sm:gap-4 lg:pt-8"
        style="--i: 4"
      >
        <Button
          as="a"
          href={withBase(site.hero.primaryCta.href)}
          variant="hero-primary"
          size="lg"
          fullWidth
          rel={undefined}
          class="justify-center sm:min-w-[220px]"
        >
          {site.hero.primaryCta.label}
        </Button>
        <Button
          as="a"
          href={withBase(site.hero.secondaryCta.href)}
          variant="hero-outline"
          size="lg"
          fullWidth
          rel={undefined}
          class="justify-center sm:min-w-[220px]"
        >
          {site.hero.secondaryCta.label}
        </Button>
      </div>
    </div>

    <a
      href="#jak-pracujeme"
      class="hero__cue absolute bottom-6 left-1/2 inline-flex min-h-11 min-w-11 -translate-x-1/2 flex-col items-center justify-center gap-1 rounded-full text-[0.7rem] uppercase tracking-overline text-white/70 no-underline transition-colors duration-fast hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
    >
      <span>Více<span class="sr-only"> – jak pracujeme</span></span>
      <span aria-hidden="true"><ChevronDownIcon class="h-5 w-5" /></span>
    </a>
  </div>
</section>

<style>
  /* Multi-stop radial gradient overlay using ink tokens (purple kept to a
     faint warmth). Tailwind can't express layered color-mix() radials. */
  .hero__overlay {
    background:
      /* royal glow – fixed value: the hero stays dark in both themes.
         Listed first so it paints above the ink veil. */
      radial-gradient(
        ellipse 75% 60% at 50% 0%,
        oklch(0.45 0.16 305.8 / 0.38),
        transparent 72%
      ),
      radial-gradient(
        ellipse at center,
        color-mix(in oklch, var(--color-ink-deep) 58%, transparent) 0%,
        color-mix(in oklch, var(--color-ink-deep) 76%, transparent) 55%,
        color-mix(in oklch, var(--color-ink-deep) 90%, transparent) 100%
      );
  }

  /* Staggered entrance; final state is the default, so content is always
     readable without motion or JS. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__rise {
      animation: hero-rise 900ms var(--ease-out-soft) both;
      animation-delay: calc(var(--i, 0) * 110ms + 120ms);
    }

    .hero__cue {
      animation: hero-cue 2.4s var(--ease-standard) 1.8s 3;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  /* Vertical bob only: the horizontal centring comes from Tailwind's
     -translate-x-1/2 (the `translate` property), which `transform` adds to. */
  @keyframes hero-cue {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.35rem);
    }
  }
</style>
