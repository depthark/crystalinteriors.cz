---
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";
import MobileMenu from "./MobileMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const activePath =
  pathname === "/" ? "/" : pathname.endsWith("/") ? pathname : `${pathname}/`;
---

<header class="glass sticky top-0 z-[var(--z-header)] border-b border-border">
  <div class="mx-auto flex max-w-7xl items-center gap-2 px-4 py-3 min-[360px]:gap-4 sm:px-6 lg:gap-8 lg:px-8">
    <a
      href={withBase("/")}
      class="relative z-[calc(var(--z-modal)+1)] flex min-w-0 items-center gap-2 no-underline min-[360px]:gap-3 sm:pr-2 lg:shrink-0"
    >
      <img
        src={withBase("/images/logos/crystalinteriors_logo-white.svg")}
        alt=""
        width="48"
        height="48"
        class="h-10 w-10 shrink-0 object-contain min-[360px]:h-12 min-[360px]:w-12 dark:[filter:none] [filter:invert(1)_brightness(0.2)]"
        loading="eager"
        decoding="async"
      />
      <span class="flex min-w-0 flex-col">
        <span class="text-[0.7rem] font-semibold uppercase leading-tight tracking-wide text-primary min-[400px]:tracking-eyebrow sm:text-[0.8rem]">
          {site.name}
        </span>
        <span class="hidden text-xs leading-snug text-muted min-[360px]:block sm:text-sm">
          Interiéry a nábytek na míru
        </span>
        <span class="sr-only"> – úvodní stránka</span>
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-6 lg:flex xl:gap-8" aria-label="Hlavní navigace">
      {
        site.nav.map((item) => {
          const isActive = activePath === item.href;
          return (
            <a
              href={withBase(item.href)}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "inline-flex min-h-11 cursor-pointer items-center whitespace-nowrap text-sm no-underline transition-colors duration-fast ease-standard hover:text-foreground",
                isActive
                  ? "relative text-foreground after:absolute after:inset-x-0 after:bottom-1.5 after:h-0.5 after:rounded-full after:bg-royal"
                  : "text-muted",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <ThemeToggle />
      <a
        href={withBase("/kontakt/#poptavka")}
        class="inline-flex min-h-11 items-center whitespace-nowrap rounded-full bg-action px-5 font-display text-sm font-semibold text-on-action no-underline shadow-card transition duration-fast ease-standard hover:-translate-y-px hover:bg-action-hover hover:shadow-lifted"
      >
        Nezávazná konzultace
      </a>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 lg:hidden">
      <!-- Header controls stay above the open mobile menu panel (z-modal). -->
      <span class="relative z-[calc(var(--z-modal)+1)] inline-flex"><ThemeToggle /></span>
      <MobileMenu pathname={pathname} />
    </div>
  </div>
</header>
