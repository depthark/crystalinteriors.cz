---
import { site } from "@/data/site";
import {
  baseGraph,
  breadcrumbList,
  shareImage,
  webPage,
} from "@/lib/structured-data";
import WebMcp from "@/components/agent/WebMcp.astro";

export interface Props {
  title: string;
  description: string;
  keywords?: string[];
  image?: string;
  imageAlt?: string;
  pathname?: string;
  /** LCP image: preloaded with the same srcset the <img> uses. */
  preload?: { src: string; srcset?: string; sizes?: string };
  breadcrumbs?: Array<{ name: string; href: string }>;
  /** Extra schema.org nodes for this page (FAQPage, Service, …). */
  schema?: Record<string, unknown>[];
  pageType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  keywords = site.keywords,
  image = site.shareImage,
  imageAlt,
  pathname = Astro.url.pathname,
  preload,
  breadcrumbs,
  schema = [],
  pageType = "WebPage",
  noindex = false,
} = Astro.props;

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME as
  | string
  | undefined;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;

const canonicalPath = pathname.startsWith("/") ? pathname : `/${pathname}`;
const canonical = `${site.siteUrl}${canonicalPath}`;
const pageTitle = canonicalPath === "/" ? `${site.name} | ${title}` : `${title} | ${site.name}`;
const ogImage = shareImage(image);
const ogImageAlt = imageAlt ?? `${site.name} — ${title}`;

const graph = [
  ...baseGraph(),
  webPage(canonical, pageTitle, description, pageType),
  ...(breadcrumbs?.length ? [breadcrumbList(canonical, breadcrumbs)] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(
  /</g,
  "\\u003c",
);
---

<!doctype html>
<html lang="cs" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="author" content={site.name} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />
    <meta name="geo.region" content="CZ-64" />
    <meta name="geo.placename" content="Brno" />
    <meta name="geo.position" content={`${site.company.geo.latitude};${site.company.geo.longitude}`} />
    <meta name="ICBM" content={`${site.company.geo.latitude}, ${site.company.geo.longitude}`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="cs" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" type="application/xml" href={asset("sitemap.xml")} />
    <link rel="alternate" type="text/markdown" title="llms.txt" href={asset("llms.txt")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="business:contact_data:street_address" content={site.company.street} />
    <meta property="business:contact_data:locality" content={site.company.city} />
    <meta property="business:contact_data:postal_code" content={site.company.postalCode} />
    <meta property="business:contact_data:country_name" content="Česká republika" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons & PWA -->
    <link rel="icon" href={asset("images/favicons/favicon.ico")} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={asset("images/favicons/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="96x96" href={asset("images/favicons/favicon-96x96.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("images/favicons/apple-touch-icon.png")} />
    <link rel="manifest" href={asset("manifest.webmanifest")} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Connections: open early, they are on the LCP path -->
    {
      cloudName && (
        <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          href={preload.src}
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      )
    }
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href={asset("styles/tailwind.css")} />
    <link rel="stylesheet" href={asset("styles/global.css")} />

    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          const stored = localStorage.getItem("theme");
          const system = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
          root.dataset.theme = stored === "dark" || stored === "light" ? stored : system;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="bg-background text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-white focus:shadow-lg"
    >
      Přeskočit na obsah
    </a>
    <slot />
    <WebMcp />
    {
      import.meta.env.PROD && (
        <script is:inline define:vars={{ swUrl: asset("sw.js"), scope: base }}>
          if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
              navigator.serviceWorker.register(swUrl, { scope }).catch(() => {});
            });
          }
        </script>
      )
    }
  </body>
</html>
