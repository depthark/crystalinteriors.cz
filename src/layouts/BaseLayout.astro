---
import { site } from "@/data/site";
import {
  baseGraph,
  breadcrumbList,
  shareImage,
  webPage,
} from "@/lib/structured-data";
import { ogImageFor } from "@/lib/og-image";
import WebMcp from "@/components/agent/WebMcp.astro";
import { readFileSync } from "node:fs";

export interface Props {
  title: string;
  description: string;
  keywords?: string[];
  image?: string;
  imageAlt?: string;
  pathname?: string;
  /** LCP image: preloaded with the same srcset the <img> uses. */
  preload?: { src: string; srcset?: string; sizes?: string };
  breadcrumbs?: Array<{ name: string; href: string }>;
  /** Extra schema.org nodes for this page (FAQPage, Service, …). */
  schema?: Record<string, unknown>[];
  pageType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  keywords = [],
  image,
  imageAlt,
  pathname = Astro.url.pathname,
  preload,
  breadcrumbs,
  schema = [],
  pageType = "WebPage",
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
// Self-hosted variable fonts (Fontsource, OFL): Latin + a tiny Czech/Slovak
// subset per family (public/fonts/, built from Latin Extended with pyftsubset).
const CZ_RANGE =
  "U+010C-010F,U+011A-011B,U+0139-013A,U+013D-013E,U+0147-0148,U+0154-0155,U+0158-0159,U+0160-0161,U+0164-0165,U+016E-016F,U+017D-017E";
const LATIN_RANGE =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const families = [
  { name: "Inter", file: "inter", weight: "100 900" },
  { name: "Manrope", file: "manrope", weight: "200 800" },
  { name: "Playfair Display", file: "playfair-display", weight: "400 900" },
];
const fontFaces = families
  .flatMap(({ name, file, weight }) =>
    [
      ["latin", LATIN_RANGE],
      ["cz", CZ_RANGE],
    ].map(
      ([subset, range]) =>
        `@font-face{font-family:"${name}";font-style:normal;font-display:swap;font-weight:${weight};src:url(${asset(`fonts/${file}-${subset}.woff2`)}) format("woff2");unicode-range:${range}}`,
    ),
  )
  .join("");

// Critical CSS is small (~9 kB brotli): inline it and skip two render-blocking
// requests. The files stay the source of truth (Tailwind CLI output + global).
const inlineCss = [fontFaces, readFileSync("public/styles/tailwind.css", "utf8"), readFileSync("public/styles/global.css", "utf8")]
  .join("\n")
  .replace(/\/\*# sourceMappingURL=.*?\*\//g, "");

// Page keywords first (as on the original site), then the studio-wide ones.
const allKeywords = [...new Set([...keywords, ...site.keywords])];

const canonicalPath = pathname.startsWith("/") ? pathname : `/${pathname}`;
const canonical = `${site.siteUrl}${canonicalPath}`;
const pageTitle = canonicalPath === "/" ? `${site.name} | ${title}` : `${title} | ${site.name}`;
// Branded per-page share image (logo + title), unless a page passes its own.
const ogImage = image ? shareImage(image) : ogImageFor(canonicalPath);
const ogImageAlt = imageAlt ?? `${site.name} — ${title}`;

const graph = [
  ...baseGraph(),
  webPage(canonical, pageTitle, description, pageType, ogImage),
  ...(breadcrumbs?.length ? [breadcrumbList(canonical, breadcrumbs)] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(
  /</g,
  "\\u003c",
);
---

<!doctype html>
<html lang="cs" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={allKeywords.join(", ")} />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="author" content={site.name} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />
    <meta name="geo.region" content="CZ-64" />
    <meta name="geo.placename" content="Brno" />
    <meta name="geo.position" content={`${site.company.geo.latitude};${site.company.geo.longitude}`} />
    <meta name="ICBM" content={`${site.company.geo.latitude}, ${site.company.geo.longitude}`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="cs" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" type="application/xml" href={asset("sitemap.xml")} />
    <link rel="alternate" type="text/markdown" title="llms.txt" href={asset("llms.txt")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={image ? undefined : "image/jpeg"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="business:contact_data:street_address" content={site.company.street} />
    <meta property="business:contact_data:locality" content={site.company.city} />
    <meta property="business:contact_data:postal_code" content={site.company.postalCode} />
    <meta property="business:contact_data:country_name" content="Česká republika" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons & PWA -->
    <link rel="icon" href={asset("images/favicons/favicon.ico")} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={asset("images/favicons/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="96x96" href={asset("images/favicons/favicon-96x96.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("images/favicons/apple-touch-icon.png")} />
    <link rel="manifest" href={asset("manifest.webmanifest")} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Fonts used above the fold: hero heading (Playfair) and body (Inter) -->
    <link rel="preload" as="font" type="font/woff2" href={asset("fonts/playfair-display-latin.woff2")} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={asset("fonts/inter-latin.woff2")} crossorigin />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={preload.src}
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      )
    }
    <style is:inline set:html={inlineCss}></style>

    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          const stored = localStorage.getItem("theme");
          const system = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
          root.dataset.theme = stored === "dark" || stored === "light" ? stored : system;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <!-- Google Tag Manager – loaded after the page (idle after load, or on the
         first interaction), so it never competes with rendering. -->
    <script is:inline>
      (function (w, d, id) {
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var done = false;
        var events = ["pointerdown", "keydown", "scroll", "touchstart"];
        function load() {
          if (done) return;
          done = true;
          events.forEach(function (e) { w.removeEventListener(e, load); });
          var j = d.createElement("script");
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + id;
          d.head.appendChild(j);
        }
        events.forEach(function (e) { w.addEventListener(e, load, { once: true, passive: true }); });
        w.addEventListener("load", function () {
          (w.requestIdleCallback || function (cb) { setTimeout(cb, 2000); })(load, { timeout: 4000 });
        });
      })(window, document, "GTM-542MMSL");
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="bg-background text-foreground antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-542MMSL"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-action focus:px-4 focus:py-2 focus:text-on-action focus:shadow-lg"
    >
      Přeskočit na obsah
    </a>
    <slot />
    <WebMcp />
    {
      import.meta.env.PROD && (
        <script is:inline define:vars={{ swUrl: asset("sw.js"), scope: base }}>
          if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
              navigator.serviceWorker.register(swUrl, { scope }).catch(() => {});
            });
          }
        </script>
      )
    }
  </body>
</html>
