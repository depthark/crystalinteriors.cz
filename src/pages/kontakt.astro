---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import EnvelopeIcon from "@/components/icons/EnvelopeIcon.astro";
import PhoneIcon from "@/components/icons/PhoneIcon.astro";
import MapPinIcon from "@/components/icons/MapPinIcon.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/data/site";

const page = site.contactPage;
const primary = site.company.contacts[0];
const roomOptions = site.services.map((service) => service.title);
// Declarative WebMCP (draft spec) — not in Astro's attribute types yet.
const webMcpForm: Record<string, string> = {
  toolname: "prefill_inquiry",
  tooldescription:
    "Předvyplní poptávkový formulář Crystal Interiors. Neodesílá ho – odeslání potvrzuje návštěvník.",
};
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  pageType="ContactPage"
  pathname="/kontakt/"
  breadcrumbs={[
    { name: "Úvod", href: "/" },
    { name: "Kontakt", href: "/kontakt/" },
  ]}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-24">
    <SectionIntro level={1} eyebrow="Kontakt" title={page.title} text={page.text} />

    <ul class="mt-10 grid list-none gap-6 sm:mt-12 md:grid-cols-2">
      {
        site.company.contacts.map((contact, index) => {
          const telHref = `tel:${contact.phone.replace(/\s+/g, "")}`;
          return (
            <li data-reveal style={`--reveal-i: ${index}`}>
              <article class="flex h-full flex-col rounded-2xl border border-border bg-surface p-6 shadow-card sm:p-8">
                <header>
                  <p class="text-xs font-medium uppercase tracking-eyebrow text-primary sm:text-sm">
                    {contact.role}
                  </p>
                  <h2 class="mt-2 text-2xl text-foreground sm:text-3xl">
                    {contact.name}
                  </h2>
                </header>

                <div class="mt-6 flex flex-col gap-3">
                  <a
                    href={`mailto:${contact.email}`}
                    class="group flex items-center gap-3 rounded-xl border border-border bg-background px-4 py-3 text-foreground transition-colors duration-fast ease-standard hover:border-primary hover:text-primary focus-visible:border-primary focus-visible:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                    aria-label={`Napsat e-mail — ${contact.name} (${contact.email})`}
                  >
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary transition-colors duration-fast ease-standard group-hover:bg-primary group-hover:text-white">
                      <EnvelopeIcon class="h-4 w-4" />
                    </span>
                    <span class="break-words text-sm sm:text-base">{contact.email.split("@")[0]}@<wbr />{contact.email.split("@")[1]}</span>
                  </a>

                  <a
                    href={telHref}
                    class="group flex items-center gap-3 rounded-xl border border-border bg-background px-4 py-3 text-foreground transition-colors duration-fast ease-standard hover:border-primary hover:text-primary focus-visible:border-primary focus-visible:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                    aria-label={`Zavolat — ${contact.name} (${contact.phone})`}
                  >
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary transition-colors duration-fast ease-standard group-hover:bg-primary group-hover:text-white">
                      <PhoneIcon class="h-4 w-4" />
                    </span>
                    <span class="text-sm sm:text-base">{contact.phone}</span>
                  </a>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-6 grid gap-6 sm:mt-8 sm:gap-8 lg:grid-cols-[0.6fr_1.4fr]">
      <address
        class="flex h-full flex-col rounded-2xl border border-border bg-surface p-6 not-italic shadow-card sm:p-7 lg:self-start"
        aria-labelledby="contact-address-label"
      >
        <div class="flex items-center gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
            <MapPinIcon class="h-5 w-5" />
          </span>
          <p id="contact-address-label" class="text-xs font-medium uppercase tracking-eyebrow text-primary sm:text-sm">
            Ateliér
          </p>
        </div>

        <p class="mt-4 text-base leading-7 text-muted sm:text-lg sm:leading-8">
          Najdete nás v Brně-Lesné. Rádi vám pomůžeme s návrhem i realizací — stavte se u nás ve vzorkovně nebo si domluvte schůzku.
        </p>

        <p class="mt-4 text-lg leading-7 text-foreground sm:text-xl sm:leading-8">
          {site.company.address}
        </p>
        <p class="mt-2 text-sm leading-6 text-muted">{site.company.openingNote}</p>
        <a
          class="mt-3 inline-flex min-h-11 items-center text-sm font-medium text-primary hover:underline"
          href={`https://www.google.com/maps/dir/?api=1&destination=${site.company.geo.latitude},${site.company.geo.longitude}`}
          target="_blank"
          rel="noopener"
        >
          Naplánovat trasu<span class="sr-only"> (otevře se v novém okně)</span> &rarr;
        </a>
        <p class="mt-6 border-t border-border pt-4 text-xs leading-5 text-muted">
          {site.company.legalName} · IČO {site.company.ico}<br />Sídlo: {site.company.registeredAddress}
        </p>
      </address>

      <div class="self-start overflow-hidden rounded-3xl border border-border shadow-card">
        <iframe
          src={site.company.mapEmbed}
          class="block h-[360px] w-full sm:h-[460px] lg:h-[520px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa — vzorkovna ${site.name}, ${site.company.address}`}
        ></iframe>
      </div>
    </div>

    <div class="mx-auto mt-10 max-w-3xl sm:mt-12">
      <section class="rounded-3xl border border-border bg-surface p-7 shadow-card md:p-9" aria-labelledby="inquiry-title" data-reveal="fade">
        <h2 id="inquiry-title" class="text-2xl text-foreground md:text-3xl">Nezávazná poptávka</h2>
        <p id="inquiry-help" class="mt-2 leading-7 text-muted">
          Vyplňte pár údajů a poptávka nám přijde rovnou do e-mailu. Odpovídáme obvykle do dvou pracovních dnů.
        </p>

        <form
          class="inquiry mt-6 grid gap-5"
          action={`mailto:${primary.email}`}
          method="post"
          enctype="text/plain"
          aria-describedby="inquiry-help inquiry-required"
          data-inquiry
          data-to={primary.email}
          data-cc={site.company.contacts.slice(1).map((c) => c.email).join(",")}
          {...webMcpForm}
        >
          <p id="inquiry-required" class="text-sm text-muted">Pole označená <span class="inquiry__mark" aria-hidden="true">*</span> jsou povinná.</p>
          <div class="inquiry__row">
            <label class="inquiry__field">
              <span>Jméno a příjmení <span class="inquiry__mark" aria-hidden="true">*</span></span>
              <input name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" placeholder="Jana Nováková" aria-describedby="inquiry-name-error" />
              <span class="inquiry__error" id="inquiry-name-error">Vyplňte prosím jméno.</span>
            </label>
            <label class="inquiry__field">
              <span>Telefon <small>(nepovinné)</small></span>
              <input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" pattern="[+0-9 \(\)\-]{9,20}" placeholder="+420 777 123 456" aria-describedby="inquiry-phone-error" />
              <span class="inquiry__error" id="inquiry-phone-error">Zadejte telefon ve tvaru +420 777 123 456.</span>
            </label>
          </div>
          <label class="inquiry__field">
            <span>E-mail <span class="inquiry__mark" aria-hidden="true">*</span></span>
            <input name="email" type="email" autocomplete="email" required maxlength="200" pattern="[^@\s]+@[^@\s]+\.[^@\s]{2,}" placeholder="jana@example.cz" aria-describedby="inquiry-email-error" />
            <span class="inquiry__error" id="inquiry-email-error">Zadejte platný e-mail, např. jana@example.cz.</span>
          </label>
          <label class="inquiry__field">
            <span>Co řešíte <small>(nepovinné)</small></span>
            <select name="room">
              <option value="">Vyberte typ prostoru</option>
              {roomOptions.map((room) => <option>{room}</option>)}
              <option>Celý byt nebo dům</option>
              <option>Jen vizualizace</option>
            </select>
          </label>
          <label class="inquiry__trap" aria-hidden="true">
            Nevyplňujte <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
          <label class="inquiry__field">
            <span>Zpráva <span class="inquiry__mark" aria-hidden="true">*</span></span>
            <textarea name="message" rows="5" required minlength="10" maxlength="4000" placeholder="Např. kuchyň 3,5 × 4 m, plánujeme realizaci na jaře…" aria-describedby="inquiry-message-error"></textarea>
            <span class="inquiry__error" id="inquiry-message-error">Napište nám prosím aspoň pár slov (min. 10 znaků).</span>
          </label>
          <div class="flex flex-wrap items-center gap-4">
            <Button as="button" type="submit" variant="primary" size="lg">Odeslat poptávku</Button>
            <p class="text-sm text-muted" role="status" aria-live="polite" data-inquiry-status></p>
          </div>
        </form>

        <div class="inquiry__success mt-6" role="status" tabindex="-1" hidden data-inquiry-success>
          <svg class="inquiry__success-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9.5" /><path d="M8 12.5l2.7 2.7L16.2 9.5" />
          </svg>
          <div>
            <p class="inquiry__success-title">{page.form.successTitle}</p>
            <p class="mt-1 leading-7">{page.form.successText}</p>
            <button type="button" class="inquiry__again" data-inquiry-again>Napsat další zprávu</button>
          </div>
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .inquiry__field {
    display: grid;
    align-content: start;
    gap: calc(var(--spacing) * 2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-foreground);
  }

  /* Fields side by side share their rows (label / input / error) through
     subgrid, so an error under one field never pushes the other out of line. */
  .inquiry__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: calc(var(--spacing) * 5);
    row-gap: calc(var(--spacing) * 2);
  }

  .inquiry__row > .inquiry__field {
    grid-row: span 3;
    grid-template-rows: subgrid;
    gap: inherit;
  }

  .inquiry__row > .inquiry__field + .inquiry__field {
    margin-top: calc(var(--spacing) * 3);
  }

  @media (min-width: 640px) {
    .inquiry__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .inquiry__row > .inquiry__field + .inquiry__field {
      margin-top: 0;
    }
  }

  .inquiry__field small {
    font-weight: 400;
    color: var(--color-subtle);
  }

  .inquiry__field :is(input, select, textarea) {
    width: 100%;
    min-height: 3rem;
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .inquiry__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .inquiry__field textarea {
    resize: vertical;
  }

  .inquiry__field :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }

  .inquiry__mark {
    color: var(--color-danger);
  }

  .inquiry__error {
    display: none;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-danger);
  }

  /* Validation states show only after the visitor touched the field (or tried
     to submit) – :user-valid / :user-invalid, no JS. Empty optional fields
     stay neutral. */
  .inquiry__field :is(input, textarea):user-invalid {
    border-color: var(--color-danger);
    box-shadow: 0 0 0 1px var(--color-danger);
    background: color-mix(in oklch, var(--color-danger-soft) 55%, var(--color-background));
  }

  .inquiry__field:has(:user-invalid) .inquiry__error {
    display: block;
  }

  .inquiry__field :is(input, textarea):user-valid:not(:placeholder-shown),
  .inquiry__field select:user-valid:has(option:checked:not([value=""])) {
    border-color: var(--color-success);
    box-shadow: 0 0 0 1px var(--color-success);
  }

  .inquiry__field :is(input, textarea):user-invalid:focus-visible {
    outline-color: var(--color-danger);
  }

  .inquiry__field :is(input, textarea):user-valid:not(:placeholder-shown):focus-visible {
    outline-color: var(--color-success);
  }

  .inquiry__field ::placeholder {
    color: var(--color-subtle);
  }

  .inquiry__success {
    display: flex;
    gap: calc(var(--spacing) * 4);
    padding: calc(var(--spacing) * 5);
    border: 1px solid var(--color-success);
    border-radius: var(--radius-lg);
    background: var(--color-success-soft);
    color: var(--color-foreground);
  }

  .inquiry[hidden],
  .inquiry__success[hidden] {
    display: none;
  }

  .inquiry__success:focus-visible {
    outline: 2px solid var(--color-success);
    outline-offset: 2px;
  }

  .inquiry__success-icon {
    flex: none;
    color: var(--color-success);
  }

  .inquiry__success-title {
    font-weight: 600;
    font-size: 1.125rem;
  }

  .inquiry__again {
    margin-top: calc(var(--spacing) * 3);
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>

<script>
  // Sends the inquiry through /api/inquiry (Resend). If the endpoint is not
  // available (GitHub Pages, missing config, outage) it falls back to a
  // prepared mailto: e-mail; without JS the native mailto form posts.
  // Validation is native (required, pattern, minlength) and styled in CSS
  // with :user-valid / :user-invalid.
  const form = document.querySelector<HTMLFormElement>("[data-inquiry]");
  const status = document.querySelector<HTMLElement>("[data-inquiry-status]");
  const success = document.querySelector<HTMLElement>("[data-inquiry-success]");
  const again = document.querySelector<HTMLButtonElement>("[data-inquiry-again]");
  const submit = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  let startedAt = Date.now();
  const endpoint = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/api/inquiry`;

  const setStatus = (text: string) => {
    if (status) status.textContent = text;
  };

  const showSuccess = () => {
    if (!form || !success) return;
    form.reset();
    form.hidden = true;
    success.hidden = false;
    success.focus();
  };

  again?.addEventListener("click", () => {
    if (!form || !success) return;
    success.hidden = true;
    form.hidden = false;
    setStatus("");
    startedAt = Date.now();
    form.querySelector<HTMLInputElement>("input[name=name]")?.focus();
  });

  const openMailto = (data: FormData) => {
    const value = (key: string) => String(data.get(key) ?? "").trim();
    const room = value("room");
    const subject = `Poptávka z webu${room ? ` – ${room}` : ""}`;
    const details = [
      `Jméno: ${value("name")}`,
      `E-mail: ${value("email")}`,
      ...(value("phone") ? [`Telefon: ${value("phone")}`] : []),
      ...(room ? [`Typ prostoru: ${room}`] : []),
    ];
    const body = [value("message"), "", ...details].join("\n");
    const cc = form?.dataset.cc ? `&cc=${encodeURIComponent(form.dataset.cc)}` : "";
    window.location.href = `mailto:${form?.dataset.to}?subject=${encodeURIComponent(subject)}${cc}&body=${encodeURIComponent(body)}`;
    setStatus("Odeslání z webu teď nefunguje – otevírám váš e-mailový program.");
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (submit) submit.disabled = true;
    setStatus("Odesílám…");
    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...Object.fromEntries(data), elapsed: Date.now() - startedAt }),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      if (response.ok) {
        setStatus("");
        showSuccess();
      } else if (response.status === 400 && result.error) {
        setStatus(result.error);
      } else {
        openMailto(data);
      }
    } catch {
      openMailto(data);
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
