---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import Button from "@/components/ui/Button.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import ResponsiveImage from "@/components/ui/ResponsiveImage.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";
import { serviceNodes } from "@/lib/structured-data";

const page = site.servicesPage;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  schema={serviceNodes()}
  pathname="/sluzby/"
  breadcrumbs={[
    { name: "Úvod", href: "/" },
    { name: "Služby", href: "/sluzby/" },
  ]}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main">
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-24">
      <SectionIntro
        level={1}
        eyebrow="Služby"
        title={page.intro.title}
        text={page.intro.text}
      />

      <div class="mt-10 grid gap-6 sm:mt-12 lg:grid-cols-2">
        {
          page.pillars.map((pillar: { eyebrow: string; title: string; text: string; image?: string; imageAlt?: string }, index: number) => (
            <article class="glass-hover group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface" data-reveal style={`--reveal-i: ${index}`}>
              {
                pillar.image && (
                  <div class="relative overflow-hidden">
                    <ResponsiveImage
                      src={pillar.image}
                      alt={pillar.imageAlt ?? ""}
                      width={1200}
                      height={675}
                      sizes="(min-width: 1280px) 600px, (min-width: 1024px) 46vw, 100vw"
                      class="aspect-[3/2] w-full object-cover transition-transform duration-700 sm:aspect-[21/9] lg:aspect-[16/9] ease-out-soft group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    />
                    <span class="pillar__shade pointer-events-none absolute inset-0" aria-hidden="true"></span>
                  </div>
                )
              }
              <div class="p-6 sm:p-8">
                <p class="text-sm font-medium uppercase tracking-eyebrow text-primary">
                  {pillar.eyebrow}
                </p>
                <h2 class="mt-4 text-2xl text-foreground sm:text-3xl">{pillar.title}</h2>
                <p class="mt-4 leading-7 text-muted sm:leading-8">{pillar.text}</p>
              </div>
            </article>
          ))
        }
      </div>

    </section>

    <section class="border-y border-border bg-surface py-12 sm:py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionIntro
          eyebrow="Ceník vizualizací"
          title="Orientační ceny"
          text={page.pricingIntro}
        />

        <dl class="mt-10 grid gap-4 sm:mt-12 md:grid-cols-2">
          {
            site.pricing.map((item) => (
              <div class="flex items-center justify-between gap-4 rounded-xl border border-border bg-background px-5 py-4">
                <dt class="leading-7 text-foreground">{item.title}</dt>
                <dd class="shrink-0 font-semibold text-primary">{item.price}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10">
          <Button as="a" href={withBase("/kontakt/")} variant="primary" size="lg" fullWidth rel={undefined} class="sm:w-auto">
            Poptat projekt
            <ArrowRightIcon class="h-5 w-5" />
          </Button>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Soft fade from the photo into the card surface (theme-aware). */
  .pillar__shade {
    background: linear-gradient(
      to bottom,
      transparent 55%,
      color-mix(in oklch, var(--color-surface) 35%, transparent)
    );
  }
</style>
