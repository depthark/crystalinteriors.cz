---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import Button from "@/components/ui/Button.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import CloudImage from "@/components/ui/CloudImage.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";
import { serviceNodes } from "@/lib/structured-data";

const page = site.servicesPage;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  schema={serviceNodes()}
  pathname="/sluzby/"
  breadcrumbs={[
    { name: "Úvod", href: "/" },
    { name: "Služby", href: "/sluzby/" },
  ]}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main">
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-24">
      <SectionIntro
        level={1}
        eyebrow="Služby"
        title={page.intro.title}
        text={page.intro.text}
      />

      <div class="mt-10 grid gap-6 sm:mt-12 lg:grid-cols-2">
        {
          page.pillars.map((pillar) => (
            <article class="glass-hover rounded-2xl border border-border bg-surface p-6 sm:p-8" data-reveal>
              <p class="text-sm font-medium uppercase tracking-eyebrow text-primary">
                {pillar.eyebrow}
              </p>
              <h2 class="mt-4 text-2xl text-foreground sm:text-3xl">{pillar.title}</h2>
              <p class="mt-4 leading-7 text-muted sm:leading-8">{pillar.text}</p>
            </article>
          ))
        }
      </div>

      <h2 class="mt-16 text-2xl text-foreground sm:text-3xl" id="spaces-title">Co navrhujeme</h2>
      <ul class="mt-8 grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3" aria-labelledby="spaces-title">
        {
          site.services.map((service) => (
            <li data-reveal>
              <article class="glass-hover h-full overflow-hidden rounded-xl border border-border bg-background shadow-card">
                <CloudImage
                  src={service.image.startsWith("/") ? withBase(service.image) : service.image}
                  alt={`${service.title} — ukázka návrhu Crystal Interiors`}
                  width={900}
                  height={675}
                  widths={[400, 600, 900, 1200]}
                  sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                  class="aspect-[4/3] w-full object-cover"
                />
                <div class="space-y-2 p-5 sm:p-6">
                  <h3 class="text-xl text-foreground">{service.title}</h3>
                  <p class="leading-7 text-muted">{service.text}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-y border-border bg-surface py-12 sm:py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionIntro
          eyebrow="Ceník vizualizací"
          title="Orientační ceny"
          text={page.pricingIntro}
        />

        <dl class="mt-10 grid gap-4 sm:mt-12 md:grid-cols-2">
          {
            site.pricing.map((item) => (
              <div class="flex items-center justify-between gap-4 rounded-xl border border-border bg-background px-5 py-4">
                <dt class="leading-7 text-foreground">{item.title}</dt>
                <dd class="shrink-0 font-semibold text-primary">{item.price}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10">
          <Button as="a" href={withBase("/kontakt/")} variant="primary" size="lg" fullWidth rel={undefined} class="sm:w-auto">
            Poptat projekt
            <ArrowRightIcon class="h-5 w-5" />
          </Button>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
