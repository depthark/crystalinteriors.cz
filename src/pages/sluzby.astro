---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";
import { serviceNodes } from "@/lib/structured-data";

const page = site.servicesPage;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  schema={serviceNodes()}
  pathname="/sluzby/"
  breadcrumbs={[
    { name: "Úvod", href: "/" },
    { name: "Služby", href: "/sluzby/" },
  ]}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main">
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <SectionIntro
        level={1}
        eyebrow="Služby"
        title={page.intro.title}
        text={page.intro.text}
      />

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          page.pillars.map((pillar) => (
            <article class="glass-hover rounded-2xl border border-border bg-surface p-8" data-reveal>
              <p class="text-sm font-medium uppercase tracking-eyebrow text-primary">
                {pillar.eyebrow}
              </p>
              <h2 class="mt-4 text-3xl text-foreground">{pillar.title}</h2>
              <p class="mt-4 leading-8 text-muted">{pillar.text}</p>
            </article>
          ))
        }
      </div>

      <ul class="mt-12 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Typy prostor, které navrhujeme">
        {
          site.services.map((service) => (
            <li class="rounded-xl border border-border bg-background p-6" data-reveal>
              <h3 class="text-xl text-foreground">{service.title}</h3>
              <p class="mt-2 leading-7 text-muted">{service.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-y border-border bg-surface py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionIntro
          eyebrow="Ceník vizualizací"
          title="Orientační ceny"
          text={page.pricingIntro}
        />

        <dl class="mt-12 grid gap-4 md:grid-cols-2">
          {
            site.pricing.map((item) => (
              <div class="flex items-center justify-between gap-4 rounded-xl border border-border bg-background px-5 py-4">
                <dt class="leading-7 text-foreground">{item.title}</dt>
                <dd class="shrink-0 font-semibold text-primary">{item.price}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10">
          <Button as="a" href={withBase("/kontakt/")} variant="primary" size="lg" rel={undefined}>
            Poptat projekt
          </Button>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
