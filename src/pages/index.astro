---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import HeroSection from "@/components/HeroSection.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import Button from "@/components/ui/Button.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import SparklesIcon from "@/components/icons/SparklesIcon.astro";
import UserGroupIcon from "@/components/icons/UserGroupIcon.astro";
import WrenchScrewdriverIcon from "@/components/icons/WrenchScrewdriverIcon.astro";
import ClockIcon from "@/components/icons/ClockIcon.astro";
import ParallaxStrip from "@/components/ParallaxStrip.astro";
import FaqSection from "@/components/FaqSection.astro";
import CloudImage from "@/components/ui/CloudImage.astro";
import { site } from "@/data/site";
import { heroPreload } from "@/lib/images";
import { faqPage } from "@/lib/structured-data";
import { withBase } from "@/lib/navigation";

const processIcons = [SparklesIcon, UserGroupIcon, WrenchScrewdriverIcon, ClockIcon];
---

<BaseLayout
  title={site.home.seo.title}
  description={site.home.seo.description}
  keywords={site.home.seo.keywords}
  pathname="/"
  imageAlt={site.hero.imageAlt}
  preload={heroPreload()}
  schema={[faqPage()]}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main">
    <HeroSection />

    <section
      id="jak-pracujeme"
      class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-28"
      aria-labelledby="approach-title"
    >
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14" data-reveal>
        <SectionIntro
          eyebrow="Jak pracujeme"
          title={site.home.introTitle}
          text={site.home.introText}
          headingId="approach-title"
        />
        <figure class="rounded-3xl border border-border bg-surface p-7 shadow-card sm:p-9 md:p-10">
          <blockquote>
            <p class="text-lg leading-7 text-foreground sm:text-xl sm:leading-8 md:text-2xl md:leading-[1.45]">
              {site.home.businessSentence}
            </p>
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3 sm:mt-7">
            <span class="h-px w-10 bg-primary"></span>
            <span class="text-xs font-medium uppercase tracking-eyebrow text-primary sm:text-sm">
              Pro klienta
            </span>
          </figcaption>
        </figure>
      </div>
    </section>

    <ParallaxStrip
      image={site.home.parallaxImage}
      eyebrow="Čím se zabýváme"
      title="Interiéry, kuchyně a nábytek na míru"
      text="Návrh, vizualizace a realizace v jedné lince — od dispozice po finální detail."
      tone="dark"
      height="md"
    />

    <section
      id="co-navrhujeme"
      class="border-y border-border bg-surface py-14 sm:py-20 lg:py-28"
      aria-labelledby="services-title"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionIntro
          eyebrow="Co navrhujeme"
          title="Od kuchyní po komerční interiéry"
          text="Navrhujeme prostory podle toho, jak se skutečně používají. Estetiku držíme ve stejné disciplíně jako funkci, rozpočet a výrobu."
          align="center"
          headingId="services-title"
        />

        <ul class="mt-10 grid list-none gap-6 sm:mt-14 md:grid-cols-2 lg:grid-cols-3">
          {
            site.services.map((service, index) => (
              <li data-reveal style={`--reveal-i: ${index % 3}`}>
                <article class="group h-full overflow-hidden rounded-xl border border-border bg-background shadow-card transition duration-300 ease-standard hover:-translate-y-1 hover:shadow-lifted">
                  <div class="overflow-hidden">
                    <CloudImage
                      src={service.image.startsWith("/") ? withBase(service.image) : service.image}
                      alt={`${service.title} — ukázka návrhu Crystal Interiors`}
                      width={900}
                      height={675}
                      widths={[400, 600, 900, 1200]}
                      sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    />
                  </div>
                  <div class="flex flex-col gap-3 p-5 sm:p-6">
                    <h3 class="text-xl text-foreground sm:text-2xl">{service.title}</h3>
                    <p class="leading-7 text-muted">{service.text}</p>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <ParallaxStrip
      image={site.home.parallaxImage}
      eyebrow="Náš přístup"
      title="Návrh, materiál i realizace v jedné ruce"
      tone="dark"
      height="sm"
    />

    <section
      class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-28"
      aria-label="Náš přístup"
    >
      <ul class="grid list-none gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          site.process.map((item, index) => {
            const Icon = processIcons[index] ?? SparklesIcon;
            return (
              <li class="flex h-full flex-col rounded-xl border border-border bg-surface p-6" data-reveal style={`--reveal-i: ${index}`}>
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary/10 text-primary">
                  <Icon class="h-5 w-5" />
                </span>
                <p class="mt-5 text-sm font-medium uppercase tracking-eyebrow text-primary">
                  {item.title}
                </p>
                <p class="mt-3 leading-7 text-muted sm:leading-8">{item.text}</p>
              </li>
            );
          })
        }
      </ul>
    </section>

    <FaqSection items={site.faq} />

    <section
      class="cta-glow relative isolate overflow-hidden border-y border-border bg-surface-elevated py-14 text-foreground sm:py-20 lg:py-24"
      aria-labelledby="cta-title"
    >
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 sm:px-6 lg:flex-row lg:items-center lg:px-8" data-reveal>
        <div class="max-w-3xl space-y-4">
          <p class="text-sm font-medium uppercase tracking-eyebrow text-primary">
            {site.home.cta.eyebrow}
          </p>
          <h2 id="cta-title" class="text-2xl leading-tight sm:text-3xl md:text-5xl">
            {site.home.cta.title}
          </h2>
        </div>
        <Button
          as="a"
          href={withBase(site.home.cta.href)}
          variant="primary"
          size="lg"
          fullWidth
          rel={undefined}
          class="lg:w-auto"
        >
          {site.home.cta.label}
          <ArrowRightIcon class="h-5 w-5" />
        </Button>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Final CTA: soft royal + lavender light behind the copy (accents only). */
  .cta-glow::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        ellipse 55% 90% at 0% 100%,
        color-mix(in oklch, var(--color-royal) 14%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 45% 80% at 100% 0%,
        color-mix(in oklch, var(--color-accent) 12%, transparent),
        transparent 70%
      );
    pointer-events: none;
  }
</style>
